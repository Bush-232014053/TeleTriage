# ---------------------------------------------------------------------------
# bKash Sandbox (Tokenized Checkout v1.2.0-beta)
# Docs: https://developer.bka.sh/docs/tokenized-checkout-overview
# Defaults below are public sandbox credentials — replace for production.
# Test wallet: 01929918378 | PIN: 12121 | OTP: 123456
# ---------------------------------------------------------------------------
BKASH_SANDBOX=true
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=4f6o0cjiki2rfm34kfdadl1eqq
BKASH_APP_SECRET=2is7hdktrekvrbljjh44ll3d9l1dtjo4pasmjvs5vl5qr3fug4b
BKASH_USERNAME=sandboxTokenizedUser02
BKASH_PASSWORD=sandboxTokenizedUser02@12345
BKASH_CALLBACK_URL=http://localhost:5000/api/payments/bkash/return

# Production bKash (uncomment and set BKASH_SANDBOX=false)
# BKASH_SANDBOX=false
# BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
# BKASH_APP_KEY=your_live_app_key
# BKASH_APP_SECRET=your_live_app_secret
# BKASH_USERNAME=your_live_username
# BKASH_PASSWORD=your_live_password

# ---------------------------------------------------------------------------
# SSLCommerz Sandbox
# Docs: https://developer.sslcommerz.com/doc/v4/
# Default sandbox store: testbox / qwerty
# SSLCommerz page lets you pick bKash, Nagad, cards, etc. inside one checkout.
# ---------------------------------------------------------------------------
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_IS_LIVE=false

# Production SSLCommerz (set SSLCOMMERZ_IS_LIVE=true)
# SSLCOMMERZ_STORE_ID=your_live_store_id
# SSLCOMMERZ_STORE_PASSWORD=your_live_store_password
# SSLCOMMERZ_IS_LIVE=true
