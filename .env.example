# Server
PORT=5000
APP_BASE_URL=http://localhost:5000
FRONTEND_ORIGIN=http://localhost:5000
JWT_SECRET=change-this-to-a-long-random-string-in-production

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=teletriage

# Python triage microservice
TRIAGE_SERVICE_URL=http://localhost:6000

# Consultation fee (BDT)
CONSULTATION_FEE=100

# bKash Sandbox (optional — payment/initiate fails cleanly without these)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=http://localhost:5000/api/payments/bkash/callback

# SSLCommerz Sandbox (optional — used by payment.html)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
